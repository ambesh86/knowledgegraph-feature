        // protein_protein: {orientation: 'UNDIRECTED', type:'*'},
        // disease_protein: {orientation: 'UNDIRECTED', type:'*'},
        // drug_protein: {orientation: 'UNDIRECTED', type:'*'},
        // anatomy_protein_present: {orientation: 'UNDIRECTED', type:'*'},
        // anatomy_protein_absent: {orientation: 'UNDIRECTED', type:'*'}
        // disease_disease: {orientation: 'UNDIRECTED', type:'*'},
        // drug_drug: {orientation: 'UNDIRECTED', type:'*'},
        // drug_effect: {orientation: 'UNDIRECTED', type:'*'}
        // 'gene_protein',
        // 'anatomy',
call gds.graph.project(
    'pubmed_graph',
    [
        'anatomy',
        'disease', 
        'drug',
        'gene_protein',
        'pubmed_document'
    ],
    {
        has_extraction: {orientation: 'UNDIRECTED', type:'*'},
        disease_disease: {orientation: 'UNDIRECTED', type:'*'},
        disease_protein: {orientation: 'UNDIRECTED', type:'*'},
        drug_protein: {orientation: 'UNDIRECTED', type:'*'},
        drug_drug: {orientation: 'UNDIRECTED', type:'*'},
        drug_effect: {orientation: 'UNDIRECTED', type:'*'},
        protein_protein: {orientation: 'UNDIRECTED', type:'*'},
        indication: {orientation: 'UNDIRECTED', type:'*'},
        contraindication: {orientation: 'UNDIRECTED', type:'*'}
    },
    {
      nodeProperties: ['model2vec_embeddings', 'node_idx', 'label_one_hot_encoding']
    }
)
yield
    graphName AS graph, nodeProjection, nodeCount AS nodes, relationshipCount AS rels
return
    graph, nodeProjection, nodes, rels;

// CALL gds.nodeSimilarity.stream('pubmed_graph')
// YIELD node1, node2, similarity
// RETURN gds.util.asNode(node1).title AS t1, gds.util.asNode(node2).title AS t2, similarity
// ORDER BY similarity DESCENDING, t1, t2;

// MATCH (n:pubmed_document)
match (article:pubmed_document)
    where article.pmcid in ['11759061', '11781120', '11759780', '11780712'] 
call gds.nodeSimilarity.filtered.stream('pubmed_graph', {
    degreeCutoff: 1,
    similarityCutoff: .45,
    topK: 1000,
    similarityMetric: "COSINE",
    sourceNodeFilter: 'pubmed_document',
    targetNodeFilter: 'pubmed_document'
})
yield node1, node2, similarity
return similarity,
gds.util.asNode(node1).title,
gds.util.asNode(node2).title
order by similarity descending;

call gds.nodeSimilarity.filtered.mutate(
    "pubmed_graph", 
    {
        topK: 2000,
        mutateProperty: "score",
        mutateRelationshipType: "article_similarity",
        sourceNodeFilter: "pubmed_document",
        targetNodeFilter: "pubmed_document"
    });

// random walk w/ restarts, train on a subset of the overall graph because graph sage is "inductive"
call gds.graph.sample.rwr('pubmed_sampled_graph', 'pubmed_graph', { samplingRatio: 0.55 })
yield nodeCount, relationshipCount
return nodeCount, relationshipCount;

// call gds.degree.mutate(
//   'pubmed_sampled_graph',
//   {
//     mutateProperty: 'degree'
//   }
// ) yield nodePropertiesWritten;

call gds.beta.graphSage.train(
    'pubmed_sampled_graph',
    {
        modelName: 'pubmed_graphsage_model',
        featureProperties: ['model2vec_embeddings', 'label_one_hot_encoding'],
        embeddingDimension: 512,
        aggregator: 'mean',
        epochs: 3,
        maxIterations: 15,
        learningRate: .075,
        batchSize: 128,
        searchDepth: 5,
        penaltyL2: .001,
        sampleSizes: [32, 12],
        activationFunction: 'relu',
        projectedFeatureDimension: 256
    }
)
yield trainMillis, configuration, modelInfo
return trainMillis, configuration, modelInfo;

call gds.beta.graphSage.mutate(
  'pubmed_graph',
  {
    mutateProperty: 'graphsage_embedding',
    modelName: 'pubmed_graphsage_model'
  }
) yield
  nodeCount,
  nodePropertiesWritten;


call gds.graph.nodeProperty.stream('pubmed_sampled_graph', 'graphsage_embedding', 
    [
        'pubmed_document'
    ]
)
yield nodeId, propertyValue
return gds.util.asNode(nodeId).title AS name, propertyValue AS embedding
order by name ASC;


call gds.graph.nodeProperty.stream('pubmed_sampled_graph', 'graphsage_embedding', 
    [
        'anatomy',
        'drug',
        'disease'
    ]
)
yield nodeId, propertyValue
return gds.util.asNode(nodeId).node_name AS name, propertyValue AS embedding
order by name ASC;



match (article:pubmed_document) 
    where article.pmcid in ['11759061', '11781120', '11759780', '11780712'] 
    with collect(article) as articles
call gds.knn.filtered.write('pubmed_sampled_graph', {
    nodeProperties: [
      {
        graphsage_embedding2: 'COSINE'
      }
    ],
    nodeLabels: ['pubmed_document'],
    topK: 6,
    sampleRate: 1.0,
    deltaThreshold: 0.001,
    similarityCutoff: .85,
    randomSeed: 75,
    concurrency: 1,
    sourceNodeFilter: articles,
    targetNodeFilter: articles,
    writeProperty: 'graphsage_score',
    writeRelationshipType: 'similar_article'
})
yield similarityDistribution
return similarityDistribution.mean as meanSimilarity;


call gds.knn.write('pubmed_graph', {
    nodeProperties: [
      {
        graphsage_embedding: 'COSINE'
      }
    ],
    nodeLabels: ['pubmed_document'],
    topK: 6,
    sampleRate: 1.0,
    deltaThreshold: 0.001,
    similarityCutoff: .85,
    randomSeed: 75,
    concurrency: 1,
    writeProperty: 'graphsage_score',
    writeRelationshipType: 'similar_article'
})
yield similarityDistribution
return similarityDistribution.mean as meanSimilarity;

call gds.knn.stream('pubmed_graph', {
    topK: 1,
    nodeLabels: ['pubmed_document'],
    nodeProperties: [
      {
        graphsage_embedding: 'COSINE'
      }
    ],
    // The following parameters are set to produce a deterministic result
    randomSeed: 75,
    concurrency: 1,
    sampleRate: 1.0,
    deltaThreshold: 0.001
})
yield node1, node2, similarity
return gds.util.asNode(node1).title AS Article1, gds.util.asNode(node2).title AS Article2, similarity
order by similarity descending, Article1, Article2;


call gds.nodeSimilarity.filtered.write(
    "pubmed_graph", 
    {
        topK: 2000,
        writeProperty: "score",
        writeRelationshipType: "similar_article",
        similarityCutoff: .45,
        similarityMetric: 'COSINE',
        sourceNodeFilter: "pubmed_document",
        targetNodeFilter: "pubmed_document"
    });


// verify
// count article knn links
MATCH (d1:pubmed_document)-[r:similar_article]-()
RETURN count(r);
// visualize paths
MATCH p=(d1:pubmed_document)-[r:similar_article]-()
where r.graphsage_score > .9
RETURN p;



match p=(n:pubmed_document)-[r:has_extraction]-(n2:disease)
where n.pmcid in ['11759061', '11781120', '11759780', '11780712']
return p


MATCH (n:pubmed_document { pmcid: '11759061' })
return n;

MATCH (n:pubmed_document { pmcid: '11759061' })
CALL db.index.vector.queryNodes('pubmed_document_model2vec_embeddings_index', 25, n.model2vec_embeddings)
YIELD node AS article, score
RETURN score, article.title AS title, article.pmcid AS pmcid;



