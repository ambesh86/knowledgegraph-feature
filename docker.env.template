# ============================================================================
# EUGENE DOCKER COMPOSE - Shared Environment Variables
# ============================================================================
# Copy this file:  cp docker.env.template docker.env
# Then fill in your credentials below.
#
# These variables are shared across all services via docker-compose.yml.
# Service-specific overrides (NEO4J_URI, EUGENE_API_BASE, etc.) are set
# directly in docker-compose.yml — you don't need to touch those.
# ============================================================================

# --- NEO4J CREDENTIALS (must match docker-compose neo4j service) ------------
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=eugene_local_2024

# --- EUGENE JWT SIGNING (shared across all backend services) ----------------
# For local dev, this can be any string — just keep it consistent
EUGENE_TENANT_ID=f8645748-68c6-4eec-bd61-c71341a6ed7d
EUGENE_CLIENT_ID=ff58ded5-c309-4cc8-ae6a-3b7157b83879
EUGENE_CLIENT_SECRET=local-dev-secret-change-me-in-production

# --- LLM PROVIDER -----------------------------------------------------------
# Bedrock Nova Lite is the default. AWS credentials come from the standard
# AWS credential chain (prefer an instance/task role; do not put AWS keys here).
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# Optional secondary provider. Prompts are sent to both providers on a primary failure.
# LLM_FALLBACK_PROVIDER=openai

# --- OPTIONAL ALTERNATE PROVIDERS --------------------------------------------
# Get your key at: https://console.anthropic.com/settings/keys
# Models: claude-sonnet-4-20250514, claude-haiku-4-5-20251001, claude-opus-4-20250514
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
# ANTHROPIC_MODEL_ID=claude-sonnet-4-20250514

# --- OPENAI API KEY (for GPT models) -----------------------------------------
# Get your key at: https://platform.openai.com/api-keys
# Models: gpt-4.1-mini, gpt-4o, gpt-4o-mini
# OPENAI_API_KEY=<your-openai-api-key>
# OPENAI_MODEL_ID=gpt-4.1-mini

# --- AGENT ALLOWLIST (pipe-separated UPNs, leave empty to allow all) --------
EUGENE_AGENT_ALLOWLIST=eugene.test@cslhering.com

# --- EUGENE SCOUT: BD partnership scanning (Use Case 1) ----------------------
# S3 is the only datastore. raw/ = staging (untouched upstream payloads),
# curated/ = final (scored signals + the index the API serves from).
SCOUT_S3_BUCKET=eugene-scout-087084717211

# USPTO Open Data Portal key — the patent source.
# Free, self-service, instant: https://developer.uspto.gov/apis
# Europe PMC's patent index is NOT usable here: measured 2026-08-08 it holds
# 139,427 records for 2011-2012 and ZERO from 2013 onward. Without this key the
# patent source degrades and says so; the other three still produce a briefing.
USPTO_API_KEY=<your-uspto-odp-api-key>

# Schedule (UTC). 02:00 is deliberately after eugene_ingestion's 01:00 sweep.
SCOUT_CRON_HOUR=2
SCOUT_CRON_MINUTE=0
SCOUT_TZ=UTC
# Weekly ranked partnership briefing. 0 = Monday.
SCOUT_WEEKLY_DIGEST_DOW=0

# Notifications are OFF by default and must be switched on deliberately.
SCOUT_NOTIFY_ENABLED=false
SCOUT_NOTIFY_WEBHOOK_URL=
# Optional SMTP alternative to the webhook.
SCOUT_SMTP_HOST=
SCOUT_SMTP_PORT=587
SCOUT_SMTP_USER=
SCOUT_SMTP_PASSWORD=
SCOUT_NOTIFY_EMAIL_FROM=eugene-scout@csl.local
SCOUT_NOTIFY_EMAIL_TO=

# Shared secret between the UI (BFF) and the scanner API. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, the scanner logs a warning and reports auth:"disabled" from /health.
SCOUT_API_TOKEN=<generate-a-random-token>
