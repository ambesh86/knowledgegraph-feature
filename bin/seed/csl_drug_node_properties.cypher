// =============================================================================
// Lift edge-level `mechanism` properties onto each Drug node as
// `mechanism_of_action`, `indication`, `description`.  These are the fields
// the existing /node/details and fetch_facts tools surface to the agent.
// Idempotent.
// =============================================================================

// CSL Behring + competitor drug catalog: per-drug node-level properties
UNWIND [
  ["csl_drug_idelvion",
   "Recombinant FIX-albumin fusion protein (rIX-FP); replaces deficient Factor IX in Hemophilia B with a half-life of ~102 hours, enabling weekly to fortnightly prophylaxis.",
   "Routine prophylaxis, on-demand treatment, and perioperative management of bleeding in adults and children with Hemophilia B."],
  ["csl_drug_afstyla",
   "Single-chain recombinant Factor VIII (lonoctocog alfa); B-domain truncated; covalent linkage of heavy and light chains gives more uniform pharmacokinetics than two-chain rFVIII products.",
   "Prophylaxis, on-demand treatment, and perioperative management of bleeding in adults and children with Hemophilia A."],
  ["csl_drug_helixate",
   "Full-length recombinant Factor VIII (octocog alfa); replaces deficient FVIII to support normal coagulation.",
   "Treatment and prophylaxis of bleeding in adults and children with Hemophilia A."],
  ["csl_drug_mononine",
   "Plasma-derived, monoclonal-antibody-purified Factor IX concentrate; replaces deficient FIX in Hemophilia B.",
   "Prevention and control of bleeding episodes in patients with Hemophilia B."],
  ["csl_drug_humate",
   "Plasma-derived complex of von Willebrand Factor and Factor VIII; restores VWF activity (ristocetin cofactor) and FVIII levels.",
   "Treatment and prophylaxis of bleeding in von Willebrand Disease (when desmopressin is ineffective or contraindicated); also for Hemophilia A."],
  ["csl_drug_berinert",
   "Plasma-derived C1 esterase inhibitor; replaces missing or dysfunctional C1-INH protein, restoring control of the contact and complement systems and aborting acute HAE attacks.",
   "Acute treatment of laryngeal, abdominal, and facial attacks of Hereditary Angioedema in adolescents and adults."],
  ["03a2b41a2411",
   "Plasma-derived C1 esterase inhibitor (subcutaneous); steady-state C1-INH levels prevent the bradykinin generation that drives HAE swelling attacks.",
   "Routine prophylaxis to prevent attacks of Hereditary Angioedema in patients aged 6 years and older."],
  ["csl_drug_andembry",
   "Garadacimab is a fully human IgG4 monoclonal antibody against activated coagulation Factor XII (FXIIa); FXIIa initiates the contact system that generates bradykinin, the mediator of HAE swelling attacks. Once-monthly subcutaneous prophylaxis.",
   "Long-term prophylaxis to prevent attacks of Hereditary Angioedema in patients aged 12 years and older."],
  ["csl_drug_privigen",
   "Liquid 10% intravenous immunoglobulin (IVIG) prepared from pooled human plasma; provides passive immunity via a broad spectrum of polyclonal IgG antibodies plus immunomodulatory Fc-receptor effects.",
   "Primary humoral immunodeficiency, chronic immune thrombocytopenic purpura (ITP), and Chronic Inflammatory Demyelinating Polyneuropathy (CIDP) maintenance."],
  ["csl_drug_hizentra",
   "20% subcutaneous immunoglobulin (SCIG) for at-home self-administration; same passive immunity mechanism as IVIG with steadier serum IgG levels and reduced systemic infusion reactions.",
   "Primary humoral immunodeficiency in patients aged 2 years and older; CIDP maintenance therapy."],
  ["csl_drug_zemaira",
   "Plasma-derived alpha-1 proteinase inhibitor (AAT); replaces deficient endogenous AAT to inhibit neutrophil elastase and slow emphysematous destruction of alveolar tissue.",
   "Chronic augmentation and maintenance therapy in adults with emphysema due to severe congenital alpha-1 antitrypsin deficiency."],
  ["csl_drug_kcentra",
   "Plasma-derived four-factor prothrombin complex concentrate (4F-PCC) containing Factors II, VII, IX, X plus proteins C and S; rapidly reverses vitamin K antagonist anticoagulation by restoring functional clotting factors.",
   "Urgent reversal of acquired coagulation factor deficiency induced by vitamin K antagonist (e.g., warfarin) therapy in adults with acute major bleeding or needing urgent surgery."],
  ["csl_drug_hemgenix",
   "AAV5 vector carrying a hyperactive Padua variant of the human Factor IX gene (FIX-Padua); after a single IV infusion, transduced hepatocytes produce FIX, restoring activity to ~36% of normal and largely eliminating the need for prophylactic FIX concentrates.",
   "One-time gene therapy for adults with Hemophilia B (Factor IX deficiency) who currently use FIX prophylaxis or have current or historical life-threatening bleeding."],
  ["csl_drug_csl112",
   "Reconstituted high-density lipoprotein infusion containing apolipoprotein A-I (apoA-I) purified from plasma; promotes ATP-binding cassette transporter A1 (ABCA1)-mediated cholesterol efflux from atherosclerotic plaques.",
   "Investigational reduction of recurrent cardiovascular events post-myocardial infarction; AEGIS-II Phase 3 missed primary endpoint Feb 2024."],
  ["csl_drug_roctavian",
   "AAV5 vector carrying a B-domain-deleted Factor VIII transgene (valoctocogene roxaparvovec); single IV infusion produces hepatocyte-derived FVIII expression, eliminating prophylactic FVIII infusions for years.",
   "One-time gene therapy for adults with severe Hemophilia A without pre-existing antibodies against AAV5 (BioMarin)."],
  ["csl_drug_takhzyro",
   "Lanadelumab, a fully human IgG1 monoclonal antibody that selectively inhibits plasma kallikrein, blocking bradykinin generation that drives HAE swelling.",
   "Long-term prophylaxis of Hereditary Angioedema attacks in patients aged 2 years and older (Takeda)."],
  ["csl_drug_orladeyo",
   "Berotralstat, an oral once-daily small-molecule selective inhibitor of plasma kallikrein; reduces bradykinin generation to prevent HAE attacks.",
   "Routine prevention of Hereditary Angioedema attacks in adults and adolescents aged 12 years and older (BioCryst)."],
  ["csl_drug_sebetralstat_ref",
   "Sebetralstat (Ekterly), an oral on-demand small-molecule plasma kallikrein inhibitor; rapidly absorbed, blocking kallikrein and bradykinin generation to abort an HAE attack.",
   "First oral on-demand treatment of Hereditary Angioedema attacks in adolescents and adults aged 12+ (KalVista; FDA Jul 2025)."],
  ["csl_drug_alhemo",
   "Concizumab, an anti-tissue-factor-pathway-inhibitor (anti-TFPI) monoclonal antibody; blocking TFPI restores thrombin generation in the absence of FVIII or FIX, providing prophylaxis irrespective of inhibitor status.",
   "Routine prophylaxis to prevent or reduce frequency of bleeding episodes in adolescents/adults with Hemophilia A or B with inhibitors (Novo Nordisk; FDA Dec 2024)."],
  ["csl_drug_hympavzi",
   "Marstacimab, an anti-TFPI monoclonal antibody; once-weekly subcutaneous prophylaxis for non-inhibitor patients with Hemophilia A or B.",
   "Routine prophylaxis to prevent or reduce frequency of bleeding episodes in adolescents/adults with Hemophilia A or B without inhibitors (Pfizer; FDA Oct 2024)."],
  ["csl_drug_qfitlia",
   "Fitusiran, a subcutaneous N-acetylgalactosamine (GalNAc)-conjugated siRNA targeting hepatic antithrombin (AT); lowering AT shifts the haemostatic balance toward thrombin generation, providing prophylaxis irrespective of FVIII / FIX deficiency or inhibitor status.",
   "Routine prophylaxis to reduce frequency of bleeding episodes in adolescents/adults with Hemophilia A or B with or without inhibitors (Sanofi; FDA Mar 2025)."],

  // Biogen drugs (lift earlier edge-level mechanism strings to node properties)
  ["biogen_drug_tecfidera",
   "Dimethyl fumarate is metabolised to monomethyl fumarate, which activates the Nrf2 antioxidant response pathway and modulates immune cell function, reducing inflammatory demyelination in multiple sclerosis.",
   "Relapsing-remitting forms of multiple sclerosis."],
  ["biogen_drug_vumerity",
   "Diroximel fumarate, a prodrug rapidly converted to monomethyl fumarate (the same active metabolite as dimethyl fumarate); offers improved gastrointestinal tolerability vs. Tecfidera.",
   "Relapsing forms of multiple sclerosis (clinically isolated syndrome, relapsing-remitting, active secondary progressive)."],
  ["biogen_drug_tysabri",
   "Natalizumab, a humanized monoclonal antibody against α4-integrin (VLA-4 / α4β7); blocks leukocyte transmigration across the blood-brain barrier into the central nervous system.",
   "Relapsing forms of multiple sclerosis; moderately to severely active Crohn's disease."],
  ["biogen_drug_plegridy",
   "Pegylated interferon beta-1a; sustained interferon receptor signalling modulates T-cell and B-cell responses, reducing relapse frequency.",
   "Relapsing forms of multiple sclerosis."],
  ["biogen_drug_avonex",
   "Interferon beta-1a; binds type-I interferon receptor on immune cells, reducing pro-inflammatory cytokines and CNS inflammation.",
   "Relapsing forms of multiple sclerosis (also approved for clinically isolated syndrome to delay onset of definite MS)."],
  ["biogen_drug_fampyra",
   "Dalfampridine, a potassium-channel blocker that prolongs action potentials in demyelinated axons, improving conduction and walking speed.",
   "Improvement of walking in patients with multiple sclerosis (EU brand: Fampyra; US brand: Ampyra)."],
  ["biogen_drug_spinraza",
   "Nusinersen, an antisense oligonucleotide that modulates SMN2 splicing to include exon 7, increasing functional SMN protein production.",
   "All types of spinal muscular atrophy (5q SMA) in pediatric and adult patients."],
  ["biogen_drug_aduhelm",
   "Aducanumab, a fully human IgG1 anti-amyloid-β monoclonal antibody targeting aggregated forms of Aβ (oligomers and fibrils); reduces amyloid plaque burden on PET imaging.",
   "Early-stage Alzheimer's disease (FDA accelerated approval 2021; commercialisation discontinued early 2024)."],
  ["biogen_drug_leqembi",
   "Lecanemab, a humanized IgG1 monoclonal antibody targeting soluble amyloid-β protofibrils; clears toxic protofibrils and reduces amyloid plaque accumulation.",
   "Early Alzheimer's disease (mild cognitive impairment or mild dementia stage with confirmed amyloid pathology). FDA traditional approval Jul 2023."],
  ["biogen_drug_qalsody",
   "Tofersen, a Vmax-modified antisense oligonucleotide that targets SOD1 mRNA for RNase H1-mediated degradation, reducing toxic mutant SOD1 protein.",
   "Amyotrophic lateral sclerosis associated with a mutation in the SOD1 gene (FDA accelerated approval Apr 2023)."],
  ["biogen_drug_skyclarys",
   "Omaveloxolone, a small-molecule activator of nuclear factor erythroid 2-related factor 2 (Nrf2); restores antioxidant gene transcription and supports mitochondrial function in frataxin-deficient cells.",
   "Friedreich's ataxia in adults and adolescents aged 16 years and older (FDA Feb 2023; brought to Biogen via Reata acquisition)."],
  ["biogen_drug_zurzuvae",
   "Zuranolone, an oral, neuroactive steroid positive allosteric modulator of synaptic and extrasynaptic GABA-A receptors; rapidly attenuates depressive symptoms via 14-day course.",
   "Postpartum depression in adults (FDA Aug 2023; co-developed with Sage Therapeutics)."]
] AS row
MATCH (d:drug { node_id: row[0] })
SET d.mechanism_of_action = row[1],
    d.indication          = row[2],
    d.description         = row[1] + " " + row[2];
