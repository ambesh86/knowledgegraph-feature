# ============================================================================
# EUGENE AGENT WEBSERVICE - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# This is the Strands-based agentic chat backend. It connects to the MCP
# server for tools and uses AWS Bedrock Nova Lite by default.
# ============================================================================

# --- RUNTIME MODE -----------------------------------------------------------
ENVIRONMENT=local

# --- MCP SERVER CONNECTION ---------------------------------------------------
# URL of the running eugene-mcp server
# Local:    http://localhost:8443/mcp
# difflabs: https://internal-eugene-search-alb-616664632.us-east-1.elb.amazonaws.com:8443/mcp
EUGENE_MCP_SERVER_URL=http://localhost:8443/mcp

# --- LLM PROVIDER ------------------------------------------------------------
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Optional failover sends the prompt to another provider if Bedrock fails.
# Keep unset unless cross-provider prompt sharing is approved.
# LLM_FALLBACK_PROVIDER=openai
# OPENAI_API_KEY=<your-openai-api-key>
# OPENAI_MODEL_ID=gpt-4.1-mini
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
# ANTHROPIC_MODEL_ID=claude-sonnet-4-20250514

# --- EUGENE JWT (Must match eugene_ws and eugene-mcp values) -----------------
EUGENE_TENANT_ID=f8645748-68c6-4eec-bd61-c71341a6ed7d
EUGENE_CLIENT_ID=ff58ded5-c309-4cc8-ae6a-3b7157b83879
EUGENE_CLIENT_SECRET=<your-eugene-signing-secret>

# --- AGENT ALLOWLIST ---------------------------------------------------------
# Pipe-separated list of user principal names (UPNs) allowed to use the agent
# Leave empty to allow all authenticated users
EUGENE_AGENT_ALLOWLIST=<user1@domain.com|user2@domain.com>
environment:
    AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID}
    AWS_SECRET_ACCESS_KEY: ${AWS_SECRET_ACCESS_KEY}
    AWS_SESSION_TOKEN: ${AWS_SESSION_TOKEN}
    AWS_REGION: ${AWS_REGION}
    AWS_DEFAULT_REGION: ${AWS_DEFAULT_REGION}