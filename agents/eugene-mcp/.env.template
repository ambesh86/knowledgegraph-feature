# ============================================================================
# EUGENE MCP SERVER - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# The MCP server wraps eugene_ws API endpoints as tools for the AI agent.
# It validates incoming JWTs and forwards them to eugene_ws.
# ============================================================================

# --- EUGENE JWT (Must match eugene_ws values) --------------------------------
EUGENE_TENANT_ID=f8645748-68c6-4eec-bd61-c71341a6ed7d
EUGENE_CLIENT_ID=ff58ded5-c309-4cc8-ae6a-3b7157b83879
EUGENE_CLIENT_SECRET=<your-eugene-signing-secret>

# --- EUGENE TOKEN VERIFICATION -----------------------------------------------
# These are derived from TENANT_ID and CLIENT_ID but must be set explicitly
EUGENE_ISSUER=https://eugene.ai.cslg1.cslg.net/${EUGENE_TENANT_ID}
EUGENE_AUDIENCE=api://eugene/${EUGENE_CLIENT_ID}

# --- EUGENE API BASE URL -----------------------------------------------------
# Points to the running eugene_ws instance
# Local:    http://localhost:8000
# difflabs: https://internal-eugene-search-alb-616664632.us-east-1.elb.amazonaws.com
EUGENE_API_BASE=http://localhost:8000
