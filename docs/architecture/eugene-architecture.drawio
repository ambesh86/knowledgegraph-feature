  <!-- ================================================================ -->
  <!-- PAGE 3: REQUEST FLOW -->
  <!-- ================================================================ -->
  <diagram id="request-flow" name="Request Flow">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="rf-title" value="&lt;b&gt;Eugene — End-to-End Request Flow&lt;/b&gt;&lt;br&gt;User asks: &quot;What drugs treat Hemophilia A?&quot;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="500" height="50" as="geometry" />
        </mxCell>

        <!-- Steps -->
        <mxCell id="s1" value="&lt;b&gt;1. User&lt;/b&gt;&lt;br&gt;Types question&lt;br&gt;in Chat UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;2. Streamlit UI&lt;/b&gt;&lt;br&gt;POST /query/stream&lt;br&gt;+ Bearer JWT&lt;br&gt;+ {prompt, tools}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#81C784;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="100" width="150" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;3. Agent WS&lt;/b&gt;&lt;br&gt;Validates JWT&lt;br&gt;Creates EugeneDataAgent&lt;br&gt;Starts Strands ReAct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="100" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="&lt;b&gt;4. LLM (GPT/Claude)&lt;/b&gt;&lt;br&gt;REASON: &quot;I need to&lt;br&gt;look up Hemophilia A&quot;&lt;br&gt;ACT: call lookup_node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#CE93D8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="100" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="&lt;b&gt;5. MCP Server&lt;/b&gt;&lt;br&gt;lookup_node_by_value&lt;br&gt;(&quot;Hemophilia A&quot;)&lt;br&gt;→ HTTP GET to API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="&lt;b&gt;6. Core API&lt;/b&gt;&lt;br&gt;/node/find/Hemophilia%20A&lt;br&gt;→ FoundationalNodeIdProvider&lt;br&gt;→ Neo4jFoundationalNodeAdapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FFB74D;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1020" y="100" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="&lt;b&gt;7. Neo4j&lt;/b&gt;&lt;br&gt;MATCH (n {node_name:&lt;br&gt;&quot;Hemophilia A&quot;})&lt;br&gt;RETURN n.node_id" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1020" y="220" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s8" value="&lt;b&gt;8. Response bubbles back&lt;/b&gt;&lt;br&gt;Neo4j → Adapter → Mapper → Provider → Router&lt;br&gt;{id: &quot;34c734&quot;, value: &quot;Hemophilia A&quot;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFE082;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="230" width="350" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s9" value="&lt;b&gt;9. LLM observes result&lt;/b&gt;&lt;br&gt;OBSERVE: Found node 34c734&lt;br&gt;REASON: Now fetch relationships&lt;br&gt;ACT: call fetch_node_relationships(&quot;34c734&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#CE93D8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="230" width="340" height="55" as="geometry" />
        </mxCell>

        <mxCell id="s10" value="&lt;b&gt;10. MCP → API → Neo4j (again)&lt;/b&gt;&lt;br&gt;MATCH (n {node_id: &quot;34c734&quot;})-[r]-{0,2}(m)&lt;br&gt;Returns: Afstyla→indication→Hemophilia A,&lt;br&gt;Eloctate→indication→Hemophilia A, ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="320" width="380" height="65" as="geometry" />
        </mxCell>

        <mxCell id="s11" value="&lt;b&gt;11. LLM generates answer&lt;/b&gt;&lt;br&gt;&quot;The following drugs treat Hemophilia A:&lt;br&gt;1. Afstyla — recombinant Factor VIII&lt;br&gt;2. Eloctate — Factor VIII Fc fusion protein&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="320" width="310" height="65" as="geometry" />
        </mxCell>

        <mxCell id="s12" value="&lt;b&gt;12. SSE Stream → UI&lt;/b&gt;&lt;br&gt;{type: &quot;content&quot;, content: &quot;The following...&quot;}&lt;br&gt;{type: &quot;done&quot;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#81C784;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1010" y="320" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- Flow arrows -->
        <mxCell id="f1" style="strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" style="strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" style="strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" style="strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" style="strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" style="strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" style="strokeColor=#82b366;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" style="strokeColor=#333;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" style="strokeColor=#333;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" style="strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="s10" target="s11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" style="strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="s11" target="s12"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
