        <mxCell id="neo4j" value="&lt;b&gt;Neo4j 5.26.9 CE&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Graph Database | Bolt: 7687 | HTTP: 7474&lt;br&gt;&lt;br&gt;• 36 node types (Drug, Disease, Gene/Protein, ...)&lt;br&gt;• 27 relationship types&lt;br&gt;• APOC 5.26.1 extended procedures&lt;br&gt;• GDS 2.13.4 graph algorithms&lt;br&gt;&lt;br&gt;Algorithms: GraphSage, FastRP,&lt;br&gt;Node Similarity, Label Propagation,&lt;br&gt;Community Detection (Leiden)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;spacingTop=5;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="990" width="280" height="195" as="geometry" />
        </mxCell>

        <mxCell id="milvus" value="&lt;b&gt;Milvus&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Vector Database | gRPC&lt;br&gt;&lt;br&gt;• Semantic search&lt;br&gt;• ANN (Approximate&lt;br&gt;  Nearest Neighbor)&lt;br&gt;• sentence-transformers&lt;br&gt;• model2vec embeddings&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;spacingTop=5;align=center;" vertex="1" parent="1">
