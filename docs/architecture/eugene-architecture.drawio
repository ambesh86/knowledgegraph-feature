        <!-- Counts Legend -->
        <mxCell id="counts-legend" value="&lt;b&gt;Current Data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• 36 node types (FoundationalNodeEnum)&lt;br&gt;• 27 relationship types (FoundationalRelationshipEnum)&lt;br&gt;• Foundation: Drug, Disease, Gene/Protein, Pathway, Anatomy, ...&lt;br&gt;• Clinical: ClinicalTrial, Sponsor, Phase, Condition, Intervention&lt;br&gt;• Patent: Patent, Patent_Application, USPTO_PGPUB&lt;br&gt;• PubMed: PUBMED_DOCUMENT, PUBMED_SUMMARY&lt;br&gt;• Organization: Organization, Research&lt;br&gt;• GraphRAG: SUMMARY, SUMMARY_FINDING&lt;br&gt;• TPP: CSL_TPP, CSL_TPP_QUESTION&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;verticalAlign=top;spacingTop=5;align=left;spacingLeft=10;" vertex="1" parent="1">
