# ============================================================================
# EUGENE CORE API (eugene_ws) - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# For local development, set ENVIRONMENT=local to bypass Entra ID OAuth
# and use a dev token instead.
# ============================================================================

# --- RUNTIME MODE -----------------------------------------------------------
# Set to "local" to skip Entra ID OAuth and issue a dev JWT at /login
# Remove or set to "production" for real OAuth flow
ENVIRONMENT=local

# --- NEO4J DATABASE ---------------------------------------------------------
# Connection to your Neo4j instance
# Local:   bolt://localhost:7687
# Docker:  bolt://host.docker.internal:7687
# Remote:  bolt+s://your-neo4j-host:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# --- EUGENE JWT (Internal Token Signing) ------------------------------------
# These are used to sign and verify Eugene-internal JWT tokens (HS256)
# All services must share the same values
EUGENE_TENANT_ID=f8645748-68c6-4eec-bd61-c71341a6ed7d
EUGENE_CLIENT_ID=ff58ded5-c309-4cc8-ae6a-3b7157b83879
EUGENE_CLIENT_SECRET=<your-eugene-signing-secret>

# --- MICROSOFT ENTRA ID (Only needed if ENVIRONMENT != local) ---------------
# OAuth 2.0 Authorization Code flow with MS Entra ID
# Not required for local development
ENTRA_TENANT_ID=<your-entra-tenant-id>
ENTRA_CLIENT_ID=<your-entra-app-client-id>
ENTRA_CLIENT_SECRET=<your-entra-client-secret>
ENTRA_AUTHORITY=https://login.microsoftonline.com/<your-entra-tenant-id>
ENTRA_SCOPE=email
REDIRECT_URI=http://localhost:8000/auth/callback
REDIRECT_PATH=/auth/callback

# --- HUGGING FACE (Optional) ------------------------------------------------
# Path to cache HuggingFace models locally (avoids re-download)
# HF_HUB_CACHE=/path/to/huggingface/cache
